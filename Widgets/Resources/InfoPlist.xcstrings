    "NSLocalNetworkUsageDescription" : {
      "comment" : "Local Network permission prompt: reading the Huawei inverter on the home network (Modbus TCP).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SunWatt reads your Huawei inverter on your home network to show live solar production."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SunWatt lee tu inversor Huawei en la red de tu casa para mostrar la producción solar en tiempo real."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O SunWatt lê o seu inversor Huawei na rede doméstica para mostrar a produção solar em tempo real."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SunWatt lit votre onduleur Huawei sur votre réseau domestique pour afficher la production solaire en direct."
