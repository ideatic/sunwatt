    "Tells you how much your solar panels produce now and today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice cuánto producen tus paneles solares ahora y hoy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-te quanto os teus painéis solares produzem agora e hoje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous indique combien vos panneaux solaires produisent maintenant et aujourd’hui."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt dir, wie viel deine Solarmodule jetzt und heute erzeugen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dice quanto producono i tuoi pannelli solari ora e oggi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt je hoeveel je zonnepanelen nu en vandaag opwekken."
          }
        }
      }
    },
    "Tells you the current electricity price and how it compares with the rest of the day.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice el precio actual de la electricidad y cómo se compara con el resto del día."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-te o preço atual da eletricidade e como se compara com o resto do dia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous indique le prix actuel de l’électricité et sa position par rapport au reste de la journée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt dir den aktuellen Strompreis und wie er im Vergleich zum Rest des Tages liegt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dice il prezzo attuale dell’elettricità e come si confronta con il resto della giornata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt je de huidige stroomprijs en hoe die zich verhoudt tot de rest van de dag."
          }
        }
      }
    },
    "Tells you the next cheapest hours to use electricity.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te dice las próximas horas más baratas para usar electricidad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Diz-te as próximas horas mais baratas para usar eletricidade."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous indique les prochaines heures les moins chères pour consommer de l’électricité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nennt dir die nächsten günstigsten Stunden für den Stromverbrauch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti dice le prossime ore più convenienti per usare l’elettricità."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt je de eerstvolgende goedkoopste uren om stroom te gebruiken."
          }
        }
      }
    },
