    "Solar production is not set up. Add your FusionSolar link in the SunWatt settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La producción solar no está configurada. Añade tu enlace de FusionSolar en los ajustes de SunWatt."
