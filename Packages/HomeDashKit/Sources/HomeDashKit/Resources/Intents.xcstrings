    "I cannot find upcoming electricity prices right now. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no encuentro los próximos precios de la electricidad. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste momento não encontro os próximos preços da eletricidade. Verifica a tua ligação e tenta novamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ne trouve pas les prochains prix de l’électricité pour le moment. Vérifiez votre connexion et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich finde gerade keine kommenden Strompreise. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento non trovo i prossimi prezzi dell’elettricità. Controlla la connessione e riprova."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik kan nu geen komende stroomprijzen vinden. Controleer je verbinding en probeer het opnieuw."
          }
        }
      }
    },
    "I cannot get the electricity price right now. Check your connection and try again.": {
      "localizations": {
        "es": {
