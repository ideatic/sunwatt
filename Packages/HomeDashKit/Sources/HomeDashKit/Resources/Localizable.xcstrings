            "value": "Risposta non valida: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldig antwoord: %@"
          }
        }
      }
    },
    "Network error: %@": {
      "localizations": {
