{
  "sourceLanguage": "en",
  "strings": {
    "Data not available yet.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos no disponibles todavía."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados ainda não disponíveis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données pas encore disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten noch nicht verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati non ancora disponibili."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gegevens nog niet beschikbaar."
          }
        }
      }
    },
    "Invalid response: %@": {
      "localizations": {
