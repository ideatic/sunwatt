    },
    "No production": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Produktion"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin producción"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de production"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna produzione"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen productie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem produção"
          }
        }
      }
    },
    "Set up the kiosk URL in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la URL del kiosco en Ajustes."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o URL do quiosque nas Definições."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez l’URL du kiosque dans les Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege die Kiosk-URL in den Einstellungen fest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l’URL del kiosk nelle Impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de kiosk-URL in bij Instellingen."
          }
        }
      }
    },
    "The kiosk URL is not valid. It must contain the kk parameter.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL del kiosco no es válida. Debe contener el parámetro kk."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O URL do quiosque não é válido. Deve conter o parâmetro kk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL du kiosque n’est pas valide. Elle doit contenir le paramètre kk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kiosk-URL ist ungültig. Sie muss den Parameter kk enthalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL del kiosk non è valido. Deve contenere il parametro kk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kiosk-URL is ongeldig. Deze moet de parameter kk bevatten."
          }
        }
      }
    },
    "The server responded with code %lld.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor respondió con el código %lld."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor respondeu com o código %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a répondu avec le code %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat mit dem Code %lld geantwortet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha risposto con il codice %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server antwoordde met code %lld."
