    "Anyone with this link can see your plant's data. Huawei refreshes kiosk data about every 30 minutes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder mit diesem Link kann die Daten Ihrer Anlage sehen. Huawei aktualisiert die Kioskdaten etwa alle 30 Minuten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera con este enlace puede ver los datos de tu planta. Huawei actualiza los datos del kiosco cada 30 minutos aproximadamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute personne disposant de ce lien peut voir les données de votre installation. Huawei actualise les données du kiosque environ toutes les 30 minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque abbia questo link può vedere i dati del tuo impianto. Huawei aggiorna i dati del chiosco circa ogni 30 minuti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen met deze link kan de gegevens van je installatie zien. Huawei ververst de kioskgegevens ongeveer elke 30 minuten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa com esta ligação pode ver os dados da sua central. A Huawei atualiza os dados do quiosque a cada 30 minutos, aproximadamente."
          }
        }
      }
    },
