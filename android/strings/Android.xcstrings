            "value": "Grande"
          }
        }
      }
    },
    "Medium": {
      "comment": "Widget size, button label. Short.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mittel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediano"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moyen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Medio"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Middel"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Médio"
          }
        }
      }
    },
    "Press an empty spot until a menu appears.": {
      "comment": "Widget guide, step 1 detail: how to open the home screen menu on Android.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie eine freie Stelle gedrückt, bis ein Menü erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un espacio vacío hasta que aparezca un menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur un endroit vide jusqu'à l'apparition du menu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un punto vuoto finché non appare un menu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een lege plek ingedrukt tot er een menu verschijnt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque sem soltar num espaço vazio até aparecer um menu."
          }
        }
      }
    },
    "Quick Settings tiles": {
      "comment": "Widget guide: section title. Use the Android term for Quick Settings tiles in this language.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kacheln der Schnelleinstellungen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosaicos de ajustes rápidos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuiles des Réglages rapides"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riquadri Impostazioni rapide"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegels voor Snelle instellingen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocos de Definições rápidas"
          }
        }
      }
    },
    "Small": {
      "comment": "Widget size, button label. Short.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeño"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Petit"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Piccolo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klein"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pequeno"
          }
        }
      }
    },
    "Swipe down twice from the top, tap the pencil icon and drag the SunWatt tiles into the panel.": {
      "comment": "Widget guide: how to add the tiles by hand on older Android versions.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen Sie zweimal von oben nach unten, tippen Sie auf das Stiftsymbol und ziehen Sie die SunWatt-Kacheln in den Bereich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza hacia abajo dos veces desde arriba, toca el icono del lápiz y arrastra los mosaicos de SunWatt al panel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez l'écran vers le bas deux fois depuis le haut, touchez l'icône en forme de crayon, puis faites glisser les tuiles SunWatt dans le panneau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri due volte verso il basso dalla parte alta dello schermo, tocca l’icona della matita e trascina i riquadri SunWatt nel pannello."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg twee keer van boven naar beneden, tik op het potloodicoon en sleep de SunWatt-tegels naar het paneel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslize duas vezes para baixo a partir do topo, toque no ícone do lápis e arraste os blocos da SunWatt para o painel."
          }
        }
      }
    },
    "Tap Widgets": {
      "comment": "Widget guide, step 2 title. 'Widgets' is the launcher menu item; use the word the Android launcher shows in this language.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Widgets tippen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Widgets"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Widgets"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Widget"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Widgets"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Widgets"
          }
        }
      }
    },
    "Touch and hold the Home Screen, tap Widgets and search for SunWatt.": {
      "comment": "Onboarding, widget page hint.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie den Home-Bildschirm gedrückt, tippen Sie auf Widgets und suchen Sie nach SunWatt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada la pantalla de inicio, toca Widgets y busca SunWatt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur l'écran d'accueil, touchez Widgets et cherchez SunWatt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
