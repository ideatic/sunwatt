    "This is not a valid address. Use the IP address of the inverter or its dongle, for example 192.168.1.50." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es una dirección válida. Usa la dirección IP del inversor o de su dongle, por ejemplo 192.168.1.50."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
