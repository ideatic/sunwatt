    "The API key or the ID was rejected. Check both, and that API access is on." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha rechazado la clave API o el ID. Revisa ambos y comprueba que el acceso a la API esté activado."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave API ou o ID foi rejeitado. Verifique ambos e se o acesso à API está ativado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé API ou l’ID a été refusé. Vérifiez les deux, et que l’accès à l’API est activé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der API-Schlüssel oder die ID wurde abgelehnt. Prüfe beides und ob der API-Zugriff aktiviert ist."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave API o l’ID non è stato accettato. Controlla entrambi e che l’accesso API sia attivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De API-sleutel of de ID is geweigerd. Controleer beide en of API-toegang aan staat."
          }
        }
      }
    },
    "The ID must be a number and the API key letters and digits only." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ID debe ser un número y la clave API solo puede tener letras y dígitos."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ID tem de ser um número e a chave API só pode ter letras e algarismos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ID doit être un nombre et la clé API ne contenir que des lettres et des chiffres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ID muss eine Zahl sein und der API-Schlüssel darf nur Buchstaben und Ziffern enthalten."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’ID deve essere un numero e la chiave API solo lettere e cifre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ID moet een getal zijn en de API-sleutel mag alleen letters en cijfers bevatten."
          }
        }
      }
    },
    "The inverter did not answer. Check the address, that you are on your home Wi-Fi, and that its local access is turned on: Modbus TCP (in a Huawei dongle: “Enable (unrestricted)”) or, on a Fronius inverter, the Solar API." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Wechselrichter hat nicht geantwortet. Prüfe die Adresse, ob du im Heim-WLAN bist und ob der lokale Zugriff eingeschaltet ist: Modbus TCP (bei einem Huawei-Dongle: “Enable (unrestricted)”) oder bei einem Fronius-Wechselrichter die Solar API."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inversor no ha respondido. Revisa la dirección, que estés en tu Wi-Fi de casa y que su acceso local esté activado: Modbus TCP (en un dongle de Huawei: “Enable (unrestricted)”) o, en un inversor Fronius, la Solar API."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’onduleur n’a pas répondu. Vérifiez l’adresse, que vous êtes bien connecté au Wi-Fi de la maison et que son accès local est activé : Modbus TCP (sur un dongle Huawei : “Enable (unrestricted)”) ou, sur un onduleur Fronius, la Solar API."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inverter non ha risposto. Controlla l'indirizzo, che tu sia connesso al Wi-Fi di casa e che l'accesso locale sia attivo: Modbus TCP (nel dongle Huawei: “Enable (unrestricted)”) oppure, su un inverter Fronius, la Solar API."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De omvormer reageert niet. Controleer het adres, of je op je thuis-wifi zit en of de lokale toegang is ingeschakeld: Modbus TCP (bij een Huawei-dongle: “Enable (unrestricted)”) of, bij een Fronius-omvormer, de Solar API."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O inversor não respondeu. Verifique o endereço, se está ligado à rede Wi-Fi de casa e se o acesso local está ativado: Modbus TCP (num dongle Huawei: “Enable (unrestricted)”) ou, num inversor Fronius, a Solar API."
          }
        }
      }
    },
    "The kiosk URL is not valid. It must contain the kk parameter." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kiosk-URL ist ungültig. Sie muss den Parameter kk enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La URL del kiosco no es válida. Debe contener el parámetro kk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL du kiosque n’est pas valide. Elle doit contenir le paramètre kk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’URL Kiosk non è valido. Deve contenere il parametro kk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kiosk-URL is ongeldig. Deze moet de parameter kk bevatten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O URL do quiosque não é válido. Deve conter o parâmetro kk."
          }
        }
      },
      "extractionState" : "manual"
    },
